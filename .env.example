# ==========================================================
# CRM Formatar - Modelo de variaveis de ambiente
# Copie para .env e preencha. O .env NUNCA vai para o Git.
#   cp .env.example .env
# ==========================================================

PORT=3000

# ---------- Provedores de IA ----------
# Preencha apenas os que forem usar. O endpoint /api/enrich-lead
# expoe em ?checkStatus=true quais estao configurados.

OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Provedor padrao quando o front nao especificar
# Valores aceitos: chatgpt | deepseek | claude | gemini
AI_PROVIDER=deepseek

# ---------- API interna Formatar ----------
USERS_API_BASE_URL=https://hub.formatar.com.br/api/users

# ---------- Protecao do endpoint de enriquecimento ----------
# Token compartilhado exigido no header x-crm-token.
# Gere um valor aleatorio longo (ex: openssl rand -hex 32).
ENRICH_ACCESS_TOKEN=

# Origem permitida no CORS. Use o dominio real em producao,
# nunca "*". Ex: https://crm.formatar.com.br
ALLOWED_ORIGIN=http://localhost:3000
