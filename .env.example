# ==========================================================
# CRM Formatar - Modelo de variaveis de ambiente
# Copie para .env e preencha. O .env NUNCA vai para o Git.
#   cp .env.example .env
# ==========================================================

PORT=3000

# ---------- Autenticacao (obrigatorio) ----------
# ID do cliente OAuth criado no Google Cloud Console.
# Nao e segredo: aparece no HTML de qualquer site com Login do Google.
GOOGLE_CLIENT_ID=

# Secret Key do hub da Formatar, com permissao hub:users:read.
# E SEGREDO. No Cloudflare, cadastre como Secret (encrypted).
HUB_API_KEY=

# ---------- Provedores de IA ----------
# Preencha apenas os que forem usar. A tela de Configuracoes
# mostra quais estao ativos, consultando /api/enrich-lead?checkStatus=true

OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
